<%- include('partials/header', { user: user }) %>

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card shadow">

            <div class="card-body p-4">

                <h2>
                    Book a Vehicle
                </h2>

                <p class="text-muted">
                    Submit your requirement.
                    Our team will check availability
                    and confirm the vehicle.
                </p>

                <form
                    method="POST"
                    action="/booking"
                >

                    <div class="mb-3">

                        <label class="form-label">
                            Vehicle Type
                        </label>

                        <select
                            name="vehicle_category"
                            class="form-select"
                            required
                        >

                            <option value="">
                                Select vehicle
                            </option>

                            <option>
                                Scorpio / SUV
                            </option>

                            <option>
                                Sedan
                            </option>

                            <option>
                                Hatchback
                            </option>

                            <option>
                                MUV / Innova
                            </option>

                            <option>
                                Luxury
                            </option>

                            <option>
                                Any Available Vehicle
                            </option>

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Pickup Address
                        </label>

                        <textarea
                            name="pickup_address"
                            class="form-control"
                            required
                        ></textarea>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Destination Address
                        </label>

                        <textarea
                            name="destination_address"
                            class="form-control"
                            required
                        ></textarea>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Pickup Date
                            </label>

                            <input
                                type="date"
                                name="pickup_date"
                                class="form-control"
                                required
                            >

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Pickup Time
                            </label>

                            <input
                                type="time"
                                name="pickup_time"
                                class="form-control"
                                required
                            >

                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Return Date
                            </label>

                            <input
                                type="date"
                                name="return_date"
                                class="form-control"
                            >

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Number of Passengers
                            </label>

                            <input
                                type="number"
                                name="passenger_count"
                                class="form-control"
                                min="1"
                                value="1"
                            >

                        </div>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Purpose
                        </label>

                        <select
                            name="purpose"
                            class="form-select"
                        >

                            <option>
                                Marriage
                            </option>

                            <option>
                                Family Function
                            </option>

                            <option>
                                Airport / Railway
                            </option>

                            <option>
                                Local Travel
                            </option>

                            <option>
                                Outstation Travel
                            </option>

                            <option>
                                Corporate / Event
                            </option>

                            <option>
                                Other
                            </option>

                        </select>

                    </div>

                    <button
                        class="btn btn-primary btn-lg w-100"
                    >
                        Submit Booking Request
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

<%- include('partials/footer') %>
